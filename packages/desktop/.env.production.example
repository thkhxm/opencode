# PunkcodeAI 桌面端生产环境变量模板
#
# 用法：
#   1. 复制本文件为 .env.production (同目录)
#   2. 按需修改下方变量
#   3. 在打包前确认：bun --cwd packages/desktop build && bun --cwd packages/desktop package:win
#
# 注意：electron-vite 会在 build 时自动加载与 NODE_ENV 匹配的 .env.* 文件，
# 并将变量通过 import.meta.env.xxx 注入 main / preload / renderer 三端。
# .env.production 不应该 commit（已加入 .gitignore），只在用户本地与打包机器存在。

# sub2api 后端 API base URL
# - 用户登录、模型列表、余额、计费均走该地址
# - 代码引用：packages/app/src/branding.ts -> DEFAULT_API_BASE_URL
PUNKCODE_API_BASE_URL=https://punkcodeai.myverse.site

# 自建 update server feed URL
# - electron-updater 从该地址下取 latest.yml + 安装包
# - 代码引用：packages/desktop/electron-builder.config.ts -> publish.url
#            packages/desktop/src/main/updater.ts (运行时覆盖)
# - 目录结构与文件清单见 deploy/UPDATE_SERVER.md
PUNKCODE_UPDATE_FEED_URL=https://punkcodeai.myverse.site/updates

# 发布通道：dev / beta / prod
# - 控制 appId、productName、update channel
# - 兼容旧名 OPENCODE_CHANNEL（电子构建会优先读 PUNKCODE_CHANNEL）
PUNKCODE_CHANNEL=prod
